<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <title>Welcome to BloodLink</title>
  </head>

  <body
    style="
      margin:0;
      padding:0;
      background-color:#f8fafc;
      font-family:Arial, Helvetica, sans-serif;
    "
  >
    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="background-color:#f8fafc;padding:40px 15px;"
    >
      <tr>
        <td align="center">

          <!-- Main Container -->
          <table
            width="600"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="
              max-width:600px;
              width:100%;
              background-color:#ffffff;
              border-radius:18px;
              overflow:hidden;
              box-shadow:0 8px 30px rgba(15,23,42,0.08);
            "
          >

            <!-- Header -->
            <tr>
              <td
                align="center"
                style="
                  background-color:#b91c1c;
                  padding:38px 25px;
                "
              >

                <div
                  style="
                    width:68px;
                    height:68px;
                    line-height:68px;
                    border-radius:50%;
                    background-color:#ffffff;
                    color:#b91c1c;
                    font-size:32px;
                    font-weight:bold;
                    margin:0 auto 16px;
                  "
                >
                  🩸
                </div>

                <h1
                  style="
                    margin:0;
                    color:#ffffff;
                    font-size:30px;
                    letter-spacing:1px;
                  "
                >
                  BloodLink
                </h1>

                <p
                  style="
                    margin:10px 0 0;
                    color:#fee2e2;
                    font-size:14px;
                  "
                >
                  Connecting donors. Saving lives.
                </p>

              </td>
            </tr>

            <!-- Content -->
            <tr>
              <td style="padding:42px 35px;">

                <h2
                  style="
                    margin:0 0 16px;
                    color:#111827;
                    font-size:24px;
                  "
                >
                  Welcome, <%= name %>! 🎉
                </h2>

                <p
                  style="
                    margin:0 0 22px;
                    color:#475569;
                    font-size:16px;
                    line-height:1.7;
                  "
                >
                  Your BloodLink account is ready.
                  We're happy to have you become part of a community
                  where a simple donation can make a life-changing difference.
                </p>

                <!-- Success Box -->
                <table
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="
                    background-color:#fef2f2;
                    border:1px solid #fecaca;
                    border-radius:12px;
                    margin:25px 0;
                  "
                >
                  <tr>
                    <td style="padding:20px;">

                      <p
                        style="
                          margin:0;
                          color:#991b1b;
                          font-size:15px;
                          line-height:1.8;
                        "
                      >
                        ✓ Email successfully verified
                        <br />
                        ✓ BloodLink account activated
                        <br />
                        ✓ You're ready to connect with the community
                      </p>

                    </td>
                  </tr>
                </table>

                <!-- Message -->
                <p
                  style="
                    margin:0 0 20px;
                    color:#475569;
                    font-size:15px;
                    line-height:1.7;
                  "
                >
                  Whether you're here to donate blood or request it when
                  someone needs help, BloodLink is built to make that
                  connection easier and faster.
                </p>

                <!-- Highlight -->
                <div
                  style="
                    text-align:center;
                    margin:30px 0;
                    padding:22px;
                    background-color:#f8fafc;
                    border-radius:12px;
                  "
                >
                  <p
                    style="
                      margin:0;
                      color:#334155;
                      font-size:16px;
                      font-weight:bold;
                    "
                  >
                    One connection can save a life. ❤️
                  </p>

                  <p
                    style="
                      margin:8px 0 0;
                      color:#94a3b8;
                      font-size:13px;
                    "
                  >
                    Thank you for being part of BloodLink.
                  </p>
                </div>

                <!-- Button -->
                <table
                  cellpadding="0"
                  cellspacing="0"
                  border="0"
                  style="margin:30px auto;"
                >
                  <tr>
                    <td
                      align="center"
                      style="
                        background-color:#b91c1c;
                        border-radius:9px;
                      "
                    >
                      <a
                        href="http://localhost:3000/login"
                        style="
                          display:inline-block;
                          padding:14px 32px;
                          color:#ffffff;
                          text-decoration:none;
                          font-size:15px;
                          font-weight:bold;
                        "
                      >
                        Go to BloodLink
                      </a>
                    </td>
                  </tr>
                </table>

                <p
                  style="
                    margin:30px 0 0;
                    color:#64748b;
                    font-size:13px;
                    line-height:1.6;
                  "
                >
                  If you have any questions or notice anything unusual
                  with your account, please contact the BloodLink support team.
                </p>

              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                align="center"
                style="
                  background-color:#f8fafc;
                  border-top:1px solid #e2e8f0;
                  padding:25px;
                "
              >

                <p
                  style="
                    margin:0 0 8px;
                    color:#334155;
                    font-size:14px;
                    font-weight:bold;
                  "
                >
                  🩸 BloodLink
                </p>

                <p
                  style="
                    margin:0;
                    color:#94a3b8;
                    font-size:12px;
                    line-height:1.5;
                  "
                >
                  This is an automated email.
                  Please do not reply directly to this message.
                </p>

                <p
                  style="
                    margin:12px 0 0;
                    color:#94a3b8;
                    font-size:12px;
                  "
                >
                  © <%= new Date().getFullYear() %>
                  BloodLink. All rights reserved.
                </p>

              </td>
            </tr>

          </table>

        </td>
      </tr>
    </table>
  </body>
</html>