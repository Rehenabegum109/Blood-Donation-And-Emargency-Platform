<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Verify Your BloodLink Account</title>
  </head>

  <body
    style="
      margin:0;
      padding:0;
      background:#f8fafc;
      font-family:Arial, Helvetica, sans-serif;
      color:#1e293b;
    "
  >
    <div style="padding:40px 15px;">

      <!-- Main Card -->
      <div
        style="
          max-width:600px;
          margin:0 auto;
          background:#ffffff;
          border-radius:20px;
          overflow:hidden;
          box-shadow:0 10px 35px rgba(15,23,42,0.08);
        "
      >

        <!-- Header -->
        <div
          style="
            background:linear-gradient(135deg,#b91c1c,#ef4444);
            padding:35px 30px;
            text-align:center;
            color:white;
          "
        >
          <div
            style="
              width:64px;
              height:64px;
              line-height:64px;
              margin:0 auto 15px;
              background:rgba(255,255,255,0.15);
              border-radius:50%;
              font-size:32px;
            "
          >
            🩸
          </div>

          <h1
            style="
              margin:0;
              font-size:30px;
              letter-spacing:1px;
            "
          >
            BloodLink
          </h1>

          <p
            style="
              margin:8px 0 0;
              font-size:14px;
              opacity:0.9;
            "
          >
            Connecting donors. Saving lives.
          </p>
        </div>

        <!-- Content -->
        <div style="padding:40px 35px;">

          <h2
            style="
              margin:0 0 15px;
              font-size:23px;
              color:#0f172a;
            "
          >
            Welcome, <%= name %> 👋
          </h2>

          <p
            style="
              margin:0 0 25px;
              line-height:1.7;
              color:#64748b;
              font-size:15px;
            "
          >
            Thanks for joining BloodLink. You're one step away from
            completing your account setup.
          </p>

          <p
            style="
              margin:0 0 12px;
              font-size:14px;
              color:#475569;
            "
          >
            Your verification code is:
          </p>

          <!-- OTP -->
          <div
            style="
              background:#fff1f2;
              border:2px dashed #f87171;
              border-radius:16px;
              padding:25px 20px;
              text-align:center;
              margin:10px 0 25px;
            "
          >
            <div
              style="
                font-size:36px;
                font-weight:bold;
                letter-spacing:10px;
                color:#b91c1c;
              "
            >
              <%= otp %>
            </div>

            <p
              style="
                margin:12px 0 0;
                font-size:12px;
                color:#9f1239;
              "
            >
              Valid for 5 minutes
            </p>
          </div>

          <!-- Security Notice -->
          <div
            style="
              background:#f8fafc;
              border-radius:12px;
              padding:16px;
              margin-bottom:25px;
            "
          >
            <p
              style="
                margin:0;
                font-size:13px;
                line-height:1.6;
                color:#64748b;
              "
            >
              🔐 <strong>Security tip:</strong>
              Never share this verification code with anyone.
              BloodLink will never ask you for your OTP.
            </p>
          </div>

          <p
            style="
              margin:0;
              font-size:13px;
              line-height:1.6;
              color:#94a3b8;
            "
          >
            Didn't create a BloodLink account?
            You can safely ignore this email.
          </p>

        </div>

        <!-- Footer -->
        <div
          style="
            background:#f8fafc;
            padding:25px;
            text-align:center;
            border-top:1px solid #e2e8f0;
          "
        >
          <p
            style="
              margin:0 0 8px;
              font-size:14px;
              font-weight:bold;
              color:#334155;
            "
          >
            🩸 BloodLink
          </p>

          <p
            style="
              margin:0;
              font-size:12px;
              color:#94a3b8;
            "
          >
            Connecting donors with those who need blood.
          </p>

          <p
            style="
              margin:12px 0 0;
              font-size:11px;
              color:#cbd5e1;
            "
          >
            © 2026 BloodLink. All rights reserved.
          </p>
        </div>

      </div>

    </div>
  </body>
</html>